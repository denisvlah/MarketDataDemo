FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Install native AOT prerequisites (clang linker + zlib headers)
RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev && rm -rf /var/lib/apt/lists/*

# Copy project files and restore
COPY MarketDataDemo.Candles/MarketDataDemo.Candles.csproj MarketDataDemo.Candles/
COPY MarketDataDemo.CsvLoader/MarketDataDemo.CsvLoader.csproj MarketDataDemo.CsvLoader/
RUN dotnet restore MarketDataDemo.CsvLoader/MarketDataDemo.CsvLoader.csproj

# Copy source and publish (AOT produces a self-contained native binary)
COPY MarketDataDemo.Candles/ MarketDataDemo.Candles/
COPY MarketDataDemo.CsvLoader/ MarketDataDemo.CsvLoader/
RUN dotnet publish MarketDataDemo.CsvLoader/MarketDataDemo.CsvLoader.csproj \
    -c Release \
    -o /app/publish

# runtime-deps provides only OS libraries — no managed runtime needed for AOT binaries
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["./MarketDataDemo.CsvLoader"]
