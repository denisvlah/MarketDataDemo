FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files and restore
COPY MarketDataDemo.KrakenHistoricalImporter/MarketDataDemo.KrakenHistoricalImporter.csproj MarketDataDemo.KrakenHistoricalImporter/
RUN dotnet restore MarketDataDemo.KrakenHistoricalImporter/MarketDataDemo.KrakenHistoricalImporter.csproj

# Copy source and publish
COPY MarketDataDemo.KrakenHistoricalImporter/ MarketDataDemo.KrakenHistoricalImporter/
RUN dotnet publish MarketDataDemo.KrakenHistoricalImporter/MarketDataDemo.KrakenHistoricalImporter.csproj \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "MarketDataDemo.KrakenHistoricalImporter.dll"]
