# sdk:10.0-noble-aot bundles clang and all AOT prerequisites — no apt-get needed
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble-aot AS build
WORKDIR /src

# Copy project files and restore
COPY MarketDataDemo.Candles/MarketDataDemo.Candles.csproj MarketDataDemo.Candles/
COPY MarketDataDemo.Api/MarketDataDemo.Api.csproj MarketDataDemo.Api/
RUN dotnet restore MarketDataDemo.Api/MarketDataDemo.Api.csproj

# Copy source and publish as a self-contained native AOT binary
COPY MarketDataDemo.Candles/ MarketDataDemo.Candles/
COPY MarketDataDemo.Api/ MarketDataDemo.Api/
RUN dotnet publish MarketDataDemo.Api/MarketDataDemo.Api.csproj \
    -c Release \
    -r linux-x64 \
    --self-contained true \
    -p:PublishAot=true \
    -p:PublishTrimmed=true \
    -o /app/publish

# runtime-deps:10.0-noble-chiseled — distroless-style, minimal OS libs only, no shell
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Native AOT produces a plain ELF binary, not a .dll
ENTRYPOINT ["./MarketDataDemo.Api"]
