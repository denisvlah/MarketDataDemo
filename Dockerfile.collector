FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files and restore
COPY S3CandlesDemo.Candles/S3CandlesDemo.Candles.csproj S3CandlesDemo.Candles/
COPY S3CandlesDemo.KrakenLatestCollector/S3CandlesDemo.KrakenLatestCollector.csproj S3CandlesDemo.KrakenLatestCollector/
RUN dotnet restore S3CandlesDemo.KrakenLatestCollector/S3CandlesDemo.KrakenLatestCollector.csproj

# Copy source and publish
COPY S3CandlesDemo.Candles/ S3CandlesDemo.Candles/
COPY S3CandlesDemo.KrakenLatestCollector/ S3CandlesDemo.KrakenLatestCollector/
RUN dotnet publish S3CandlesDemo.KrakenLatestCollector/S3CandlesDemo.KrakenLatestCollector.csproj \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "S3CandlesDemo.KrakenLatestCollector.dll"]
