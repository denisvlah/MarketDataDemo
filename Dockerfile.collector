FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files and restore
COPY MarketDataDemo.Candles/MarketDataDemo.Candles.csproj MarketDataDemo.Candles/
COPY MarketDataDemo.KrakenLatestCollector/MarketDataDemo.KrakenLatestCollector.csproj MarketDataDemo.KrakenLatestCollector/
RUN dotnet restore MarketDataDemo.KrakenLatestCollector/MarketDataDemo.KrakenLatestCollector.csproj

# Copy source and publish
COPY MarketDataDemo.Candles/ MarketDataDemo.Candles/
COPY MarketDataDemo.KrakenLatestCollector/ MarketDataDemo.KrakenLatestCollector/
RUN dotnet publish MarketDataDemo.KrakenLatestCollector/MarketDataDemo.KrakenLatestCollector.csproj \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "MarketDataDemo.KrakenLatestCollector.dll"]
