{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "S3Candles": {
    "Bucket": "your-bucket-name",
    "Prefix": "candles",
    "AWS": {
      "AccessKey": "your-access-key",
      "SecretKey": "your-secret-key",
      "Region": "us-east-1"
    }
  },
  "HistoricalImport": {
    "TempDirectory": "/tmp/kraken-historical",
    "GoogleApiKey": "your-google-api-key"
  }
}
